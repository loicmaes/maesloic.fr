generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id         Int       @id @default(autoincrement())
  title      String
  caption    String
  icon       String
  displayed  Boolean   @default(false)
  archivedAt DateTime?
}

model Project {
  id             Int       @id @default(autoincrement())
  title          String
  caption        String
  thumbnail      String?
  tags           String[]  @default([])
  content        String
  previewLink    String?
  productionLink String?
  draft          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
}
