{
  "name": "maesloic.fr",
  "version": "0.1.0",
  "author": "Loïc MAES",
  "description": "Discover my digital profile in a simple way.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "tsx ./prisma/seed.ts"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "nuxt build --host",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nuxt/eslint": "1.4.1",
    "@nuxt/image": "1.10.0",
    "@nuxtjs/color-mode": "3.5.2",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/i18n": "9.5.5",
    "@pinia/nuxt": "0.11.1",
    "@prisma/client": "^6.9.0",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.0.0",
    "lucide-vue-next": "^0.513.0",
    "nuxt": "^3.17.5",
    "pinia": "^3.0.3",
    "reka-ui": "^2.3.1",
    "shadcn-nuxt": "2.2.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.3.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.0",
    "zod": "^3.25.61"
  },
  "devDependencies": {
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite-plugin-eslint2": "^5.0.3"
  }
